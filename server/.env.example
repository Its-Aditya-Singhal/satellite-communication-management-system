# --- MySQL ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=scms
# least-privilege account used by the API (created by 07_roles_grants.sql)
MYSQL_USER=scms_app
MYSQL_PASSWORD=scms_app_pw
# admin account used only by scripts/init-db.js to build the schema
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# --- MongoDB ------------------------------------------------------------
# local:  mongodb://127.0.0.1:27017
# Atlas:  Database -> Connect -> Drivers, copy the mongodb+srv:// string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=scms

# --- API -----------------------------------------------------------------
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
